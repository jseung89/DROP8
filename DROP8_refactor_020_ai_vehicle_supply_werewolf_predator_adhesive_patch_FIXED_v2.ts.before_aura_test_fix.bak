// DROP 8 Refactor 020 FIXED v2 — AI Vehicle, Werewolf Predator & Adhesive Control
// Cumulative replacement for FIXED v1. Run this v2 directly against the uploaded current source or a successfully applied v1 source.
// Windows CMD:
//   node --experimental-strip-types DROP8_refactor_020_ai_vehicle_supply_werewolf_predator_adhesive_patch_FIXED_v2.ts --dry-run
//   node --experimental-strip-types DROP8_refactor_020_ai_vehicle_supply_werewolf_predator_adhesive_patch_FIXED_v2.ts
//   node --experimental-strip-types DROP8_refactor_020_ai_vehicle_supply_werewolf_predator_adhesive_patch_FIXED_v2.ts --rollback "patch_backups\refactor_020_ai_vehicle_werewolf_predator_adhesive\<timestamp>"
import { copyFileSync, cpSync, existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { dirname, isAbsolute, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { gunzipSync } from 'node:zlib';
import { spawnSync } from 'node:child_process';

type Entry={path:string;purpose:string;mode:'modify'|'create';acceptedBeforeSha256:string[];afterSha256:string;content:string};
type Payload={marker:string;entries:Entry[]};
type Manifest={patchId:string;patchFile:string;createdAt:string;projectRoot:string;files:Array<{path:string;existed:boolean;beforeSha256:string;eol:'LF'|'CRLF';bom:boolean}>;createdFiles:string[];generatedDirs:Array<{path:string;existed:boolean}>;protectedSnapshot:Record<string,string>};

const PATCH_ID='DROP8 Refactor 020 AI Vehicle Werewolf Predator Adhesive FIXED v2';
const PATCH_FILE='DROP8_refactor_020_ai_vehicle_supply_werewolf_predator_adhesive_patch_FIXED_v2.ts';
const BACKUP_NAME='refactor_020_ai_vehicle_werewolf_predator_adhesive';
const PAYLOAD_B64='';
const payload=JSON.parse(gunzipSync(Buffer.from(PAYLOAD_B64,'base64')).toString('utf8')) as Payload;
const args=process.argv.slice(2),dryRun=args.includes('--dry-run'),rollbackIndex=args.indexOf('--rollback');
const internal=process.env.DROP8_PATCH_INTERNAL_TEST==='1';
const forceFail=process.env.DROP8_PATCH_FORCE_FAIL==='1';
const self=fileURLToPath(import.meta.url);

function sha(data:Buffer|string){return createHash('sha256').update(data).digest('hex');}
function read(path:string){return readFileSync(path,'utf8');}
function eol(text:string):'LF'|'CRLF'{return text.includes('\r\n')?'CRLF':'LF';}
function hasBom(text:string){return text.charCodeAt(0)===0xfeff;}
function safe(rel:string){const normalized=rel.replace(/\\/g,'/');if(!normalized||normalized.startsWith('/')||normalized.split('/').includes('..'))throw new Error(`안전하지 않은 경로: ${rel}`);return normalized;}
function findRoot(){
  const candidates=[process.cwd(),dirname(self)];
  for(const start of candidates){let dir=resolve(start);for(let i=0;i<8;i++){if(existsSync(join(dir,'package.json'))&&existsSync(join(dir,'server/src/rooms/Drop8Room.ts'))&&existsSync(join(dir,'shared/src/werewolfSeason.ts')))return dir;const parent=dirname(dir);if(parent===dir)break;dir=parent;}}
  throw new Error('DROP 8 프로젝트 루트를 찾지 못했습니다. 패치 파일을 프로젝트 루트에서 실행하세요.');
}
function timestamp(){return new Date().toISOString().replace(/[-:]/g,'').replace(/\..+$/,'').replace('T','_');}
function atomicWrite(path:string,text:string){mkdirSync(dirname(path),{recursive:true});const temp=`${path}.drop8-ref020v2-${process.pid}.tmp`;writeFileSync(temp,text,'utf8');renameSync(temp,path);}
function captureProtected(root:string){
  const room=read(join(root,'server/src/rooms/Drop8Room.ts'));
  const shared=read(join(root,'shared/src/index.ts'));
  const wolf=read(join(root,'shared/src/werewolfSeason.ts'));
  const vehicle=read(join(root,'shared/src/vehicleEffects.ts'));
  const line=(text:string,needle:string)=>text.split(/\r?\n/).find((value)=>value.includes(needle))?.trim()??'미검출';
  return{
    aiNames:line(room,'const AI_NAMES='),shotgun:line(shared,"shotgun:{"),flamethrower:line(shared,"flamethrower:{"),bazooka:line(shared,"bazooka:{"),silverCrossbow:line(shared,"silver_crossbow:{"),werewolfDefenseBefore:line(wolf,'bulletDamageMultiplier:'),adhesiveVehicleBefore:line(vehicle,'motorcycle:{speedMultiplier:'),aiMarkers:[...room.matchAll(/^\/\/ DROP8_(?:REFACTOR_019|AI_PATROL|AI_COMBAT|AI_LARGE)[^\r\n]*/gm)].map((match)=>match[0]).join(' | '),
  };
}
function validateProtected(root:string){
  const room=read(join(root,'server/src/rooms/Drop8Room.ts')),shared=read(join(root,'shared/src/index.ts')),wolf=read(join(root,'shared/src/werewolfSeason.ts')),vehicle=read(join(root,'shared/src/vehicleEffects.ts'));
  for(const marker of ['DROP8_REFACTOR_019_AI_HUMANIZATION','DROP8_AI_PATROL_STABILITY_HOTFIX','DROP8_AI_COMBAT_WALL_GUARD','DROP8_AI_LARGE_BUILDING_PERIMETER_HOTFIX'])if(!room.includes(marker))throw new Error(`필수 기존 AI 핫픽스 누락: ${marker}`);
  for(const name of ['준희커','대성(빅뱅)','양정횬','페이커','케리아','윤석10','손흥민'])if(!room.includes(`'${name}'`))throw new Error(`AI 이름 보호 검증 실패: ${name}`);
  const required:Array<[string,RegExp]>=[['샷건',/shotgun:\{[^\n]*damage:15[^\n]*magazine:5[^\n]*spread:\.18[^\n]*pellets:8/],['화염방사기',/flamethrower:\{[^\n]*damage:9[^\n]*range:420/],['바주카포',/bazooka:\{[^\n]*reloadSeconds:4\.2[^\n]*projectileSpeed:900/],['은제 석궁',/silver_crossbow:\{[^\n]*fireInterval:\.42[^\n]*magazine:4[^\n]*reloadSeconds:1\.35[^\n]*projectileSpeed:2100[^\n]*pellets:5/]];
  for(const [name,pattern] of required)if(!pattern.test(shared))throw new Error(`수동 밸런스 보호 검증 실패: ${name}`);
  if(!/bulletDamageMultiplier:\.25,explosionDamageMultiplier:\.40,otherDamageMultiplier:\.20/.test(wolf)&&!wolf.includes('DROP8_REFACTOR_020_WEREWOLF_PREDATOR_ADHESIVE_BALANCE'))throw new Error('Refactor 020 v2 기준 늑대 방어력 선행 상태를 확인할 수 없습니다.');
  if(!/motorcycle:\{speedMultiplier:\.55,accelerationMultiplier:\.40,steeringMultiplier:\.75,durationSeconds:4,maxDurationSeconds:6\}/.test(vehicle)&&!vehicle.includes('DROP8_REFACTOR_020_WEREWOLF_PREDATOR_ADHESIVE_BALANCE'))throw new Error('Refactor 020 v2 기준 점착 차량 밸런스 선행 상태를 확인할 수 없습니다.');
}
function validatePackage(root:string){const pkg=JSON.parse(read(join(root,'package.json'))) as {scripts?:Record<string,string>};for(const script of ['typecheck','lint','test','build'])if(!pkg.scripts?.[script])throw new Error(`package.json 필수 script 누락: ${script}`);}
function markerState(root:string){let applied=0,before=0;const conflicts:string[]=[];for(const entry of payload.entries){const target=join(root,safe(entry.path));if(!existsSync(target)){if(entry.mode==='create')before++;else conflicts.push(`${entry.path}(누락)`);continue;}const digest=sha(readFileSync(target));if(digest===entry.afterSha256)applied++;else if(entry.acceptedBeforeSha256.includes(digest))before++;else conflicts.push(`${entry.path}(업로드 분석본·v1과 다른 내용)`);}return{applied,before,conflicts,total:payload.entries.length};}
function backupAndWrite(root:string){
  const backup=join(root,'patch_backups',BACKUP_NAME,timestamp()),pre=join(backup,'preimage');mkdirSync(pre,{recursive:true});
  const manifest:Manifest={patchId:PATCH_ID,patchFile:PATCH_FILE,createdAt:new Date().toISOString(),projectRoot:root,files:[],createdFiles:[],generatedDirs:[],protectedSnapshot:captureProtected(root)};
  for(const entry of payload.entries){const rel=safe(entry.path),target=join(root,rel),existed=existsSync(target);if(existed){const original=readFileSync(target),backupFile=join(pre,rel);mkdirSync(dirname(backupFile),{recursive:true});copyFileSync(target,backupFile);const text=original.toString('utf8');manifest.files.push({path:rel,existed:true,beforeSha256:sha(original),eol:eol(text),bom:hasBom(text)});}else{manifest.files.push({path:rel,existed:false,beforeSha256:'',eol:'LF',bom:false});manifest.createdFiles.push(rel);}}
  for(const rel of ['shared/dist','client/dist','server/build']){const target=join(root,rel),existed=existsSync(target);manifest.generatedDirs.push({path:rel,existed});if(existed){const dest=join(backup,'generated-preimage',rel);mkdirSync(dirname(dest),{recursive:true});cpSync(target,dest,{recursive:true,preserveTimestamps:true});}}
  writeFileSync(join(backup,'manifest.json'),JSON.stringify(manifest,null,2),'utf8');for(const entry of payload.entries)atomicWrite(join(root,safe(entry.path)),entry.content);return backup;
}
function rollback(root:string,arg:string){const backup=isAbsolute(arg)?arg:resolve(root,arg),manifestPath=join(backup,'manifest.json');if(!existsSync(manifestPath))throw new Error(`manifest를 찾지 못했습니다: ${manifestPath}`);const manifest=JSON.parse(read(manifestPath)) as Manifest;if(manifest.patchId!==PATCH_ID)throw new Error(`다른 패치 백업입니다: ${manifest.patchId}`);for(const item of [...manifest.files].reverse()){const target=join(root,safe(item.path));if(item.existed){const source=join(backup,'preimage',safe(item.path));if(!existsSync(source))throw new Error(`백업 파일 누락: ${item.path}`);mkdirSync(dirname(target),{recursive:true});copyFileSync(source,target);}else rmSync(target,{force:true});}for(const dir of manifest.generatedDirs){const target=join(root,safe(dir.path));rmSync(target,{recursive:true,force:true});if(dir.existed){const source=join(backup,'generated-preimage',safe(dir.path));if(existsSync(source))cpSync(source,target,{recursive:true,preserveTimestamps:true});}}console.log(`[${PATCH_ID}] 롤백 완료: ${backup}`);}
function verifyAfter(root:string){for(const entry of payload.entries){const target=join(root,safe(entry.path));if(!existsSync(target)||sha(readFileSync(target))!==entry.afterSha256)throw new Error(`적용 후 무결성 실패: ${entry.path}`);}}
function run(label:string,command:string,root:string,log:string){console.log(`\n[${PATCH_ID}] ${label}\n> ${command}`);const result=spawnSync(command,{cwd:root,shell:true,encoding:'utf8',maxBuffer:96*1024*1024,env:process.env});const text=`\n### ${label}\n> ${command}\nexit=${result.status}\n${result.stdout??''}\n${result.stderr??''}\n`;writeFileSync(log,text,{encoding:'utf8',flag:'a'});if(result.stdout)process.stdout.write(result.stdout);if(result.stderr)process.stderr.write(result.stderr);if(result.error)throw result.error;if(result.status!==0)throw new Error(`${label} 실패 (exit=${result.status})`);}

const root=findRoot();process.chdir(root);console.log(`[${PATCH_ID}] 프로젝트 루트: ${root}`);
if(rollbackIndex>=0){const arg=args[rollbackIndex+1];if(!arg)throw new Error('--rollback 뒤에 백업 폴더를 입력하세요.');rollback(root,arg);process.exit(0);}
validatePackage(root);const state=markerState(root);if(state.conflicts.length)throw new Error(`기준 코드 충돌: ${state.conflicts.join(', ')}`);if(state.applied===state.total){verifyAfter(root);console.log(`[${PATCH_ID}] 이미 정상 적용되어 있습니다.`);process.exit(0);}if(state.applied>0)console.log(`[${PATCH_ID}] v1 또는 일부 최종 파일 감지: ${state.applied}/${state.total}. 나머지를 v2 최종본으로 통합합니다.`);
validateProtected(root);const protectedSnapshot=captureProtected(root);console.log(`[${PATCH_ID}] 기존 AI·무기 밸런스 보호 확인:`);for(const [key,value] of Object.entries(protectedSnapshot))console.log(` - ${key}: ${value}`);
console.log(`\n[${PATCH_ID}] 변경 예정 파일:`);for(const entry of payload.entries)console.log(` - [${entry.mode==='create'?'신규':'수정'}] ${entry.path} :: ${entry.purpose}`);
console.log(`[${PATCH_ID}] 누적 기능: AI 오토바이·보급·제단 쟁탈전 + 늑대 추격/방어 + 근접 오라 도트 + 오토바이 지속 접촉 강제 하차 + 점착 3단계/잔류 회복`);
console.log(`[${PATCH_ID}] 오토바이 기본 속도·체력·충돌 공격력은 변경하지 않습니다.`);console.log(`[${PATCH_ID}] 예상 백업: patch_backups\\${BACKUP_NAME}\\<timestamp>`);
if(dryRun){console.log(`\n[${PATCH_ID}] dry-run 성공: 실제 파일과 백업을 만들지 않았습니다.`);process.exit(0);}
const backup=backupAndWrite(root),log=join(backup,'verification-log.txt');writeFileSync(log,'','utf8');
try{verifyAfter(root);if(forceFail)throw new Error('DROP8_PATCH_FORCE_FAIL=1 강제 실패');if(!internal){
  run('TypeScript typecheck','pnpm run typecheck',root,log);run('ESLint','pnpm run lint',root,log);
  run('Refactor 020 shared 늑대·점착 테스트','pnpm --filter @drop8/shared exec vitest run tests/refactor017-adhesive-status.test.ts tests/refactor018-werewolf-season.test.ts --reporter=verbose',root,log);
  run('Refactor 020 AI 차량·늑대·점착 집중 테스트','pnpm --filter @drop8/server exec vitest run tests/refactor020-ai-vehicle-objective.test.ts tests/refactor020-werewolf-adhesive-balance.test.ts --pool=threads --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 --reporter=verbose',root,log);
  run('차량·보급·늑대·점착·Room 회귀 테스트','pnpm --filter @drop8/server exec vitest run tests/room.test.ts tests/refactor015a-supply-flamethrower.test.ts tests/refactor017-adhesive-strip-trap.test.ts tests/refactor018-werewolf-ritual-transform.test.ts tests/refactor018-werewolf-combat.test.ts --pool=threads --maxWorkers=1 --no-file-parallelism --testTimeout=30000 --hookTimeout=30000 --reporter=verbose',root,log);
  run('전체 테스트','pnpm run test',root,log);run('전체 빌드','pnpm run build',root,log);run('Refactor 020 v2 대상 git diff check',`git diff --check -- ${payload.entries.map((entry)=>`"${entry.path}"`).join(' ')}`,root,log);
}else console.log(`[${PATCH_ID}] 내부 복제본 검증 모드: pnpm 명령 생략`);console.log(`\n[${PATCH_ID}] 적용 성공`);console.log(`[${PATCH_ID}] 백업: ${backup}`);console.log(`[${PATCH_ID}] 롤백 CMD: node --experimental-strip-types ${PATCH_FILE} --rollback "${relative(root,backup)}"`);
}catch(error){console.error(`\n[${PATCH_ID}] 검증 실패. 전체 자동 롤백합니다.`);try{rollback(root,backup);}catch(rollbackError){console.error('자동 롤백 오류',rollbackError);}console.error(`[${PATCH_ID}] 백업: ${backup}`);throw error;}
